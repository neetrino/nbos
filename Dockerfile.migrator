# syntax=docker/dockerfile:1
# NBOS one-shot Prisma migrator — Coolify nbos-migrate.
# Separate file because Coolify create/update API rejects dockerfile_target_build.
FROM node:22-bookworm-slim AS migrator

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV HUSKY=0
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates curl wget \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

ENV NODE_ENV=development

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json

RUN --mount=type=cache,id=pnpm-migrator,target=/pnpm/store \
  pnpm install --frozen-lockfile --prod=false --filter @nbos/database...

COPY packages/database/prisma.config.ts packages/database/prisma.config.ts
COPY packages/database/prisma/schema packages/database/prisma/schema
COPY packages/database/prisma/migrations packages/database/prisma/migrations
COPY packages/database/scripts/coolify-migrate.sh packages/database/scripts/coolify-migrate.sh

ENV NODE_ENV=production

# Prisma CLI reads DIRECT_URL from env (prisma.config.ts). Exit code is Prisma's.
# PRISMA_MIGRATE_MODE=status|reconcile|deploy (default deploy).
# Coolify Dockerfile apps do not reliably override CMD — keep logic in-image.
RUN chmod +x packages/database/scripts/coolify-migrate.sh
CMD ["sh", "packages/database/scripts/coolify-migrate.sh"]
