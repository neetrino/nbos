# syntax=docker/dockerfile:1
# NBOS API — Coolify / Docker
FROM node:22-bookworm-slim AS base

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV HUSKY=0
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates curl wget \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

FROM base AS builder

# Coolify may inject NODE_ENV=production at build time — keep development here so Nest/TS devDeps install.
ENV NODE_ENV=development

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json

# API subgraph only (~4 workspace projects) — full monorepo install OOMs on small Coolify hosts.
RUN --mount=type=cache,id=pnpm-api,target=/pnpm/store \
  pnpm install --frozen-lockfile --prod=false --filter @nbos/api...

COPY . .

ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"
ENV DIRECT_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"

RUN pnpm db:generate
RUN pnpm build:api
# Production slice only (~460 packages vs full monorepo ~1570) — avoids OOM on COPY to runner.
RUN pnpm --filter @nbos/api deploy --prod /prod/api

# One-shot production migrator. Keep this stage BEFORE runner so Coolify apps
# that omit dockerfile_target_build still boot the API/worker/scheduler image.
FROM base AS migrator

ENV NODE_ENV=development
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json

RUN --mount=type=cache,id=pnpm-migrator,target=/pnpm/store \
  pnpm install --frozen-lockfile --prod=false --filter @nbos/database...

COPY packages/database/prisma.config.ts packages/database/prisma.config.ts
COPY packages/database/prisma/schema packages/database/prisma/schema
COPY packages/database/prisma/migrations packages/database/prisma/migrations

ENV NODE_ENV=production

# Prisma CLI reads DIRECT_URL from env (prisma.config.ts). Exit code is Prisma's.
CMD ["pnpm", "--filter", "@nbos/database", "migrate:deploy"]

FROM base AS runner

ENV NODE_ENV=production
ENV PORT=4000

WORKDIR /app

COPY --from=builder /prod/api /app

EXPOSE 4000

# One image serves all production roles. Dockerfile-based Coolify applications
# do not reliably override CMD with the application start command.
CMD ["sh", "-c", "case \"$PROCESS_ROLE\" in api) exec node --import tsx dist/main.js ;; worker) exec node --import tsx dist/worker.js ;; scheduler) exec node --import tsx dist/scheduler.js ;; *) echo \"Invalid PROCESS_ROLE=$PROCESS_ROLE (expected api|worker|scheduler)\" >&2; exit 1 ;; esac"]
