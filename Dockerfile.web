# syntax=docker/dockerfile:1
# NBOS Web — Coolify / Docker
FROM node:22-bookworm-slim AS base

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV HUSKY=0
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

FROM base AS builder

# Install devDependencies (TypeScript, Tailwind); switch to production before `next build`.
ENV NODE_ENV=development

ARG APP_URL
ARG BACKEND_URL
ARG NEXT_PUBLIC_BACKEND_URL

ENV APP_URL=$APP_URL
ENV BACKEND_URL=$BACKEND_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json

# Web subgraph only — skip Nest/Prisma API deps; full monorepo install OOMs on small Coolify hosts.
RUN --mount=type=cache,id=pnpm-web,target=/pnpm/store \
  pnpm install --frozen-lockfile --prod=false --filter @nbos/web...

COPY . .

ENV NODE_ENV=production
# Typecheck runs in CI; skipping here avoids OOM on memory-constrained build hosts.
ENV SKIP_NEXT_TYPECHECK=1

RUN pnpm build:web
# Production slice for runner — avoids OOM on COPY of full monorepo node_modules.
RUN pnpm --filter @nbos/web deploy --prod /prod/web

FROM base AS runner

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

ARG APP_URL
ARG BACKEND_URL
ARG NEXT_PUBLIC_BACKEND_URL

ENV APP_URL=$APP_URL
ENV BACKEND_URL=$BACKEND_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL

WORKDIR /app

COPY --from=builder /prod/web /app
# pnpm deploy skips .gitignored build output — next start requires .next at package root.
COPY --from=builder /app/apps/web/.next ./.next

EXPOSE 3000

CMD ["pnpm", "start"]
