# NBOS — Environment
# Copy uncommented keys to .env.local and fill real values.
#
# Rule: a line that starts with "# KEY=" is NOT required.
# Those are production/ops knobs. Code already has safe defaults (usually off).
# Copy a commented key only when you are enabling that one feature today.
# Do not paste the whole catalog into Coolify.

# ─────────────────────────────────────────────
# A. Local required (pnpm dev)
# ─────────────────────────────────────────────
NODE_ENV="development"

# Same origin in the browser. APP_URL = links in mail/callbacks (API).
# AUTH_URL = Auth.js session (/api/auth/*). NEXTAUTH_URL = alias; can equal AUTH_URL.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Nest origin for BFF and server-side login.
BACKEND_URL="http://localhost:4000"
# Browser Socket.IO / public API host when it differs from the page origin.
# NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

# Comma-separated browser origins (CORS, Socket.IO). Not the API address.
CORS_ORIGIN="http://localhost:3000"

# Neon: pooler for app, direct for Prisma migrate.
DATABASE_URL="postgresql://app_user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neon_owner:password@ep-xxx.neon.tech/neondb?sslmode=require"

# NextAuth session secret (min 32 chars): openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Backend access-token secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

PORT=4000
CREDENTIALS_ENCRYPTION_KEY=""

# First admin for: pnpm --filter @nbos/database run seed:admin
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─────────────────────────────────────────────
# B. Optional integrations (empty = feature off)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="nbos@neetrino.com"
RESEND_ADMIN_EMAIL=""

# Drive uploads: R2 + stable tenant UUID in object paths.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nbos"
R2_PUBLIC_URL=""
NBOS_TENANT_ORGANIZATION_ID="00000000-0000-4000-8000-000000000001"

# Gmail OAuth only. Redirect: <BACKEND_URL>/api/mail/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# MAIL_GMAIL_PUBSUB_TOPIC=""
# MAIL_GMAIL_PUBSUB_TOKEN=""

# Prefer URL + token in Settings → Integrations (encrypted in DB).
