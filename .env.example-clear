# ─────────────────────────────────────────────
# C. Production process split — do not set locally
# Local default is PROCESS_ROLE=all. Production forbids all.
# Coolify: three services, same image (see docs/deploy.md).
# ─────────────────────────────────────────────
# PROCESS_ROLE="api"
# REDIS_URL="redis://..."
# REDIS_QUEUE_URL="redis://..."
# REDIS_STATE_URL="redis://..."
# REDIS_EVENTS_URL="redis://..."
# Required in production (external cron + scheduler HTTP).
# SCHEDULER_API_KEY=""
# WORKER_HEALTH_PORT=4001
# WORKER_SHUTDOWN_TIMEOUT_MS=45000
# BULLMQ_MAIL_CONCURRENCY=5
# BULLMQ_WHATSAPP_CONCURRENCY=3
# BULLMQ_REPORTS_CONCURRENCY=1
# BULLMQ_DRIVE_ZIP_CONCURRENCY=1
# Never enable in production (runs export inside the API process).
# REPORT_EXPORT_SYNC_FALLBACK="false"
# LOG_LEVEL="info"

# ─────────────────────────────────────────────
# D. Recurring tasks — how production creates Task instances
# Pick ONE trigger. Do not enable both (double spawn).
#
# 1) External cron (recommended if you already call /api/scheduler/*):
#    every 5 min, no SCHEDULER_RECURRING_TASKS_* flags needed:
#    POST /api/scheduler/recurring-tasks-due
#    Header: x-scheduler-key: $SCHEDULER_API_KEY
#
# 2) Dedicated nbos-scheduler only (PROCESS_ROLE=scheduler, not api):
#    SCHEDULER_ENABLED=true
#    SCHEDULER_RECURRING_TASKS_DUE_ENABLED=true
#    SCHEDULER_RECURRING_TASKS_DUE_CRON="*/5 * * * *"
#
# Setting ENABLED=true on PROCESS_ROLE=api does nothing (cron will not register).
# Local: set ENABLED=true only if you want in-process cron during pnpm dev.
# ─────────────────────────────────────────────
# SCHEDULER_RECURRING_TASKS_DUE_ENABLED="false"
# SCHEDULER_RECURRING_TASKS_DUE_CRON="*/5 * * * *"

# ─────────────────────────────────────────────
# E. Other scheduler jobs — same pattern as D, enable only the job you want
# Dedicated scheduler also needs SCHEDULER_ENABLED=true.
# ─────────────────────────────────────────────
# SCHEDULER_ENABLED="false"
# SCHEDULER_LEASE_TTL_MS=120000
# SCHEDULER_HEARTBEAT_INTERVAL_MS=30000
# SCHEDULER_HEALTH_PORT=4002
# SCHEDULER_SHUTDOWN_TIMEOUT_MS=45000
# SCHEDULER_MAX_CONCURRENT_RUNS=2
# SCHEDULER_EXPENSE_PLAN_AUTO_DUE_ENABLED="false"
# SCHEDULER_EXPENSE_PLAN_AUTO_DUE_CRON="0 2 * * *"
# REPORT_SCHEDULES_DUE_CRON_ENABLED="false"
# SCHEDULER_CREDENTIAL_TRASH_PURGE_ENABLED="false"
# SCHEDULER_PLATFORM_TRASH_PURGE_ENABLED="false"
# SCHEDULER_NOTIFICATION_INBOX_RECONCILE_ENABLED="false"
# SCHEDULER_NOTIFICATION_INBOX_RECONCILE_CRON="*/15 * * * *"
# SCHEDULER_NOTIFICATION_ENQUEUE_RECONCILE_ENABLED="false"
# SCHEDULER_NOTIFICATION_ENQUEUE_RECONCILE_CRON="*/10 * * * *"
# SCHEDULER_AUTH_SESSION_CLEANUP_ENABLED="false"
# AUTH_SESSION_CLEANUP_BATCH_SIZE=500

