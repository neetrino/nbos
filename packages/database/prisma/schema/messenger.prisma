// ─── INTERNAL MESSENGER (MVP) ─────────────────────────────

enum MessengerChannelType {
  PROJECT
  GENERAL
  ANNOUNCEMENT
}

model MessengerChannel {
  id        String               @id @default(uuid())
  name      String
  projectId String               @map("project_id")
  type      MessengerChannelType
  createdAt DateTime             @default(now()) @map("created_at")

  messages   MessengerChannelMessage[]
  readStates MessengerChannelReadState[]

  @@map("messenger_channels")
}

model MessengerChannelMessage {
  id                 String           @id @default(uuid())
  channelId          String           @map("channel_id")
  channel            MessengerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId           String           @map("sender_id")
  sender             Employee         @relation("MessengerChannelMessageSender", fields: [senderId], references: [id])
  senderNameSnapshot String           @map("sender_name_snapshot")
  content            String           @db.Text
  editedAt           DateTime?        @map("edited_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  attachments MessengerChannelMessageAttachment[]

  @@index([channelId, createdAt])
  @@map("messenger_channel_messages")
}

model MessengerChannelMessageAttachment {
  id           String   @id @default(uuid())
  messageId    String   @map("message_id")
  fileAssetId  String   @map("file_asset_id")
  attachedById String?  @map("attached_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  message    MessengerChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset               @relation(fields: [fileAssetId], references: [id])
  attachedBy Employee?               @relation("MessengerChannelAttachmentActor", fields: [attachedById], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([fileAssetId])
  @@map("messenger_channel_message_attachments")
}

model MessengerChannelReadState {
  id         String   @id @default(uuid())
  channelId  String   @map("channel_id")
  employeeId String   @map("employee_id")
  lastReadAt DateTime @map("last_read_at")

  channel  MessengerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([channelId, employeeId])
  @@index([employeeId])
  @@map("messenger_channel_read_states")
}

model MessengerDirectThread {
  id             String   @id @default(uuid())
  participantAId String   @map("participant_a_id")
  participantBId String   @map("participant_b_id")
  participantA   Employee @relation("MessengerDmThreadParticipantA", fields: [participantAId], references: [id])
  participantB   Employee @relation("MessengerDmThreadParticipantB", fields: [participantBId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  messages   MessengerDirectMessage[]
  readStates MessengerDirectThreadReadState[]

  @@unique([participantAId, participantBId])
  @@map("messenger_direct_threads")
}

model MessengerDirectMessage {
  id                 String                @id @default(uuid())
  threadId           String                @map("thread_id")
  thread             MessengerDirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId           String                @map("sender_id")
  sender             Employee              @relation("MessengerDirectMessageSender", fields: [senderId], references: [id])
  senderNameSnapshot String                @map("sender_name_snapshot")
  content            String                @db.Text
  editedAt           DateTime?             @map("edited_at")
  createdAt          DateTime              @default(now()) @map("created_at")

  attachments MessengerDirectMessageAttachment[]

  @@index([threadId, createdAt])
  @@map("messenger_direct_messages")
}

model MessengerDirectMessageAttachment {
  id           String   @id @default(uuid())
  messageId    String   @map("message_id")
  fileAssetId  String   @map("file_asset_id")
  attachedById String?  @map("attached_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  message    MessengerDirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset              @relation(fields: [fileAssetId], references: [id])
  attachedBy Employee?              @relation("MessengerDirectAttachmentActor", fields: [attachedById], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([fileAssetId])
  @@map("messenger_direct_message_attachments")
}

model MessengerDirectThreadReadState {
  id         String   @id @default(uuid())
  threadId   String   @map("thread_id")
  employeeId String   @map("employee_id")
  lastReadAt DateTime @map("last_read_at")

  thread   MessengerDirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([threadId, employeeId])
  @@index([employeeId])
  @@map("messenger_direct_thread_read_states")
}

// ─── MESSAGING CORE (evolved Unified generation) ──────────
// Canonical durable Messaging Core (M-CORE-01). Slice 3 Internal UI reads/writes Core.
// Channel/DM remains the rollback store; do not DROP. Mapper is idempotent and not dual-write.
// NBOS Internal Messenger is single-organization (no tenantId on Employee); isolation is application RBAC.

enum MessengerConversationType {
  PROJECT_GENERAL
  PRODUCT
  DEAL
  TASK
  WORKSPACE
  DIRECT
  INTERNAL_GROUP
  EXTERNAL
}

enum MessengerConversationStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

enum MessengerParticipantRole {
  OWNER
  ADMIN
  MEMBER
  READ_ONLY
}

enum MessengerLinkEntityType {
  PROJECT
  PRODUCT
  DEAL
  TASK
  WORKSPACE
  TICKET
  CLIENT
}

enum MessengerLinkRelationType {
  PRIMARY
  RELATED
}

enum MessengerMessageType {
  TEXT
  SYSTEM
}

model MessengerConversation {
  id                      String                       @id @default(uuid())
  zone                    MessengerConversationZone    @default(INTERNAL)
  kind                    MessengerConversationKind    @default(ENTITY)
  type                    MessengerConversationType
  title                   String?
  status                  MessengerConversationStatus  @default(ACTIVE)
  createdById             String?                      @map("created_by_id")
  /// Deterministic uniqueness key: project_general:{id} | product:{id} | workspace:{id} | deal:{id} | task:{id} | direct:{low}:{high} | legacy:channel:{id}
  canonicalKey            String?                      @unique @map("canonical_key")
  /// Normalized DIRECT pair (lexicographic employee UUID order). Null for non-DIRECT types.
  directParticipantLowId  String?                      @map("direct_participant_low_id")
  directParticipantHighId String?                      @map("direct_participant_high_id")
  metadata                Json?
  lastMessageAt           DateTime?                    @map("last_message_at")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")

  createdBy             Employee?                              @relation("MessengerConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  directParticipantLow  Employee?                              @relation("MessengerConversationDirectLow", fields: [directParticipantLowId], references: [id], onDelete: Restrict)
  directParticipantHigh Employee?                              @relation("MessengerConversationDirectHigh", fields: [directParticipantHighId], references: [id], onDelete: Restrict)
  participants          MessengerConversationParticipant[]
  links                 MessengerConversationLink[]
  messages              MessengerMessage[]
  readStates            MessengerConversationReadState[]
  userSettings          MessengerUserConversationSetting[]
  externalMappings      MessengerExternalConversationMapping[]
  commands              MessengerCommand[]
  legacyIdentities      MessengerLegacyIdentity[]
  sourceReferences      MessengerMessageReference[]            @relation("MessengerMessageReferenceSourceConversation")
  targetReferences      MessengerMessageReference[]            @relation("MessengerMessageReferenceTargetConversation")
  collectionItems       MessengerConversationCollectionItem[]

  @@unique([directParticipantLowId, directParticipantHighId])
  @@index([type, status])
  @@index([zone, status])
  @@index([lastMessageAt])
  @@index([status, updatedAt])
  @@map("messenger_conversations")
}

model MessengerConversationParticipant {
  id             String                  @id @default(uuid())
  conversationId String                  @map("conversation_id")
  employeeId     String                  @map("employee_id")
  role           MessengerParticipantRole @default(MEMBER)
  joinedAt       DateTime                @default(now()) @map("joined_at")
  leftAt         DateTime?               @map("left_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  conversation MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee     Employee              @relation("MessengerConversationParticipantEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([conversationId, employeeId])
  @@index([employeeId, leftAt])
  @@index([conversationId, leftAt])
  @@map("messenger_conversation_participants")
}

model MessengerConversationLink {
  id             String                      @id @default(uuid())
  conversationId String                      @map("conversation_id")
  entityType     MessengerLinkEntityType     @map("entity_type")
  entityId       String                      @map("entity_id")
  relationType   MessengerLinkRelationType   @map("relation_type")
  createdAt      DateTime                    @default(now()) @map("created_at")

  conversation MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, entityType, entityId, relationType])
  @@index([conversationId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, relationType])
  @@map("messenger_conversation_links")
}

model MessengerMessage {
  id                  String                     @id @default(uuid())
  conversationId      String                     @map("conversation_id")
  senderId            String?                    @map("sender_id")
  senderNameSnapshot  String                     @map("sender_name_snapshot")
  content             String                     @db.Text
  messageType         MessengerMessageType       @default(TEXT) @map("message_type")
  direction           MessengerMessageDirection  @default(INTERNAL)
  status              MessengerMessageStatus     @default(SENT)
  provenance          MessengerMessageProvenance @default(EMPLOYEE)
  replyToMessageId    String?                    @map("reply_to_message_id")
  threadRootMessageId String?                    @map("thread_root_message_id")
  idempotencyKey      String?                    @map("idempotency_key")
  editedAt            DateTime?                  @map("edited_at")
  deletedAt           DateTime?                  @map("deleted_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  conversation       MessengerConversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             Employee?                     @relation("MessengerMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo            MessengerMessage?             @relation("MessengerMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies            MessengerMessage[]            @relation("MessengerMessageReply")
  threadRoot         MessengerMessage?             @relation("MessengerMessageThreadRoot", fields: [threadRootMessageId], references: [id], onDelete: SetNull)
  threadReplies      MessengerMessage[]            @relation("MessengerMessageThreadRoot")
  attachments        MessengerMessageAttachment[]
  reactions          MessengerMessageReaction[]
  referencesAsSource MessengerMessageReference[]   @relation("MessengerMessageReferenceSource")
  referencesAsTarget MessengerMessageReference[]   @relation("MessengerMessageReferenceTarget")
  commands           MessengerCommand[]

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToMessageId])
  @@index([threadRootMessageId])
  @@map("messenger_messages")
}

model MessengerMessageAttachment {
  id           String   @id @default(uuid())
  messageId    String   @map("message_id")
  fileAssetId  String   @map("file_asset_id")
  attachedById String?  @map("attached_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  message    MessengerMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  attachedBy Employee?        @relation("MessengerMessageAttachmentActor", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([messageId, fileAssetId])
  @@index([fileAssetId])
  @@map("messenger_message_attachments")
}

model MessengerConversationReadState {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  employeeId     String   @map("employee_id")
  lastReadAt     DateTime @map("last_read_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee     Employee              @relation("MessengerConversationReadStateEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, employeeId])
  @@index([employeeId])
  @@map("messenger_conversation_read_states")
}

model MessengerUserConversationSetting {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  employeeId     String   @map("employee_id")
  pinned         Boolean  @default(false)
  muted          Boolean  @default(false)
  favorite       Boolean  @default(false)
  lastOpenedAt   DateTime? @map("last_opened_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee     Employee              @relation("MessengerUserConversationSettingEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, employeeId])
  @@index([employeeId, pinned])
  @@index([employeeId, favorite])
  @@map("messenger_user_conversation_settings")
}
