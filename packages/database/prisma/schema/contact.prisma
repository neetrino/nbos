// ─── CONTACT & COMPANY ────────────────────────────────────

enum ContactRole {
  CLIENT
  PARTNER
  CONTRACTOR
  OTHER
}

model Contact {
  id             String      @id @default(uuid())
  firstName      String      @map("first_name")
  lastName       String      @map("last_name")
  phone          String?
  email          String?
  messengerLinks Json?       @map("messenger_links")
  role           ContactRole @default(CLIENT)
  notes          String?
  trashedAt      DateTime?   @map("trashed_at")
  /// Profile A pointer after Contact merge; absorbed card is also trashed. Not hard delete.
  mergedIntoId   String?     @map("merged_into_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  companies           Company[] @relation("CompanyPrimaryContact")
  billingForCompanies Company[] @relation("CompanyBillingContact")
  projects            Project[]
  products            Product[]
  leads               Lead[]
  deals               Deal[]
  tickets             SupportTicket[]
  leadsAsSource       Lead[]               @relation("LeadSourceContact")
  dealsAsSource       Deal[]               @relation("DealSourceContact")
  dealAdditionalLinks DealAdditionalContact[] @relation("DealAdditionalContact")
  leadAdditionalLinks LeadAdditionalContact[] @relation("LeadAdditionalContact")
  projectAdditionalLinks ProjectAdditionalContact[] @relation("ProjectAdditionalContact")
  productAdditionalLinks ProductAdditionalContact[] @relation("ProductAdditionalContact")
  companyAdditionalLinks CompanyAdditionalContact[] @relation("CompanyAdditionalContact")
  partners            Partner[]
  partnerServiceTerms PartnerServiceTerm[]
  whatsappClientInvitations ProductWhatsAppClientInvitation[]
  extraPhones         ContactPhone[]
  atsCallEvents       AtsCallEvent[] @relation("AtsCallContact")
  mergedInto          Contact?       @relation("ContactMergedInto", fields: [mergedIntoId], references: [id])
  absorbedContacts    Contact[]      @relation("ContactMergedInto")
  googleContactMapping GoogleContactMapping?

  @@index([trashedAt])
  @@index([phone])
  @@index([mergedIntoId])
  @@map("contacts")
}

/// Extra numbers on a Contact. `Contact.phone` stays the primary.
model ContactPhone {
  id        String   @id @default(uuid())
  contactId String   @map("contact_id")
  e164      String
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, e164])
  @@index([e164])
  @@map("contact_phones")
}

enum CompanyType {
  LEGAL
  INDIVIDUAL
  SOLE_PROPRIETOR
}

enum TaxStatus {
  TAX
  TAX_FREE
}

model Company {
  id           String      @id @default(uuid())
  name         String
  legalName    String?     @map("legal_name")
  type         CompanyType @default(LEGAL)
  taxId        String?     @map("tax_id")
  legalAddress String?     @map("legal_address")
  bankDetails  Json?       @map("bank_details")
  taxStatus    TaxStatus   @default(TAX)
  contactId    String?     @map("contact_id")
  billingContactId String? @map("billing_contact_id")
  phone        String?
  email        String?
  country      String?
  notes        String?
  trashedAt    DateTime?   @map("trashed_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  contact                   Contact?                  @relation("CompanyPrimaryContact", fields: [contactId], references: [id])
  billingContact            Contact?                  @relation("CompanyBillingContact", fields: [billingContactId], references: [id])
  additionalContacts        CompanyAdditionalContact[]
  projects                  Project[]
  invoices                  Invoice[]
  deals                     Deal[]
  operationalJournalEntries OperationalJournalEntry[]
  partnerServiceTerms       PartnerServiceTerm[]

  @@index([trashedAt])
  @@map("companies")
}

/// Extra client contacts on a company (v1 list; primary remains `Company.contactId`).
model CompanyAdditionalContact {
  companyId String @map("company_id")
  contactId String @map("contact_id")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation("CompanyAdditionalContact", fields: [contactId], references: [id], onDelete: Cascade)

  @@id([companyId, contactId])
  @@map("company_additional_contacts")
}
