// ─── INTEGRATIONS (Meta MVP) ────────────────────────────────

enum IntegrationProviderEnum {
  META
}

enum MetaPlatformEnum {
  INSTAGRAM
  FACEBOOK
}

enum MetaConnectedAccountStatusEnum {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum MetaMessageDirectionEnum {
  INBOUND
  OUTBOUND
}

enum MetaMessageTypeEnum {
  TEXT
  EMPTY
  UNSUPPORTED
}

model MetaConnectedAccount {
  id                         String                         @id @default(uuid())
  provider                   IntegrationProviderEnum        @default(META)
  platform                   MetaPlatformEnum
  displayName                String                         @map("display_name")
  pageId                     String                         @map("page_id")
  instagramBusinessAccountId String?                        @map("instagram_business_account_id")
  externalAccountId          String                         @map("external_account_id")
  marketingAccountId         String?                        @map("marketing_account_id")
  connectedByUserId          String                         @map("connected_by_user_id")
  status                     MetaConnectedAccountStatusEnum @default(CONNECTED)
  tokenExpiresAt             DateTime?                      @map("token_expires_at")
  scopes                     Json?
  lastErrorAt                DateTime?                      @map("last_error_at")
  lastErrorMessage           String?                        @map("last_error_message") @db.Text
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")

  marketingAccount MarketingAccount? @relation(fields: [marketingAccountId], references: [id], onDelete: SetNull)
  connectedBy      Employee          @relation("MetaConnectedBy", fields: [connectedByUserId], references: [id], onDelete: Restrict)
  providerSecret   MetaProviderSecret?
  senderIdentities MetaSenderIdentity[]
  conversations    MetaConversation[]
  messages           MetaMessage[]

  @@unique([provider, externalAccountId])
  @@index([marketingAccountId])
  @@index([status])
  @@index([pageId])
  @@index([instagramBusinessAccountId])
  @@map("meta_connected_accounts")
}

model MetaProviderSecret {
  id                    String   @id @default(uuid())
  metaConnectedAccountId String  @unique @map("meta_connected_account_id")
  encryptedSecret       String   @map("encrypted_secret") @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  metaConnectedAccount MetaConnectedAccount @relation(fields: [metaConnectedAccountId], references: [id], onDelete: Cascade)

  @@map("meta_provider_secrets")
}

model MetaProviderEvent {
  id          String                  @id @default(uuid())
  provider    IntegrationProviderEnum @default(META)
  eventId     String                  @map("event_id")
  objectId    String                  @map("object_id")
  eventType   String?                 @map("event_type")
  leadId      String?                 @map("lead_id")
  processedAt DateTime?               @map("processed_at")
  payload     Json?
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([objectId])
  @@index([leadId])
  @@map("meta_provider_events")
}

model MetaSenderIdentity {
  id                    String           @id @default(uuid())
  platform              MetaPlatformEnum
  metaConnectedAccountId String          @map("meta_connected_account_id")
  senderScopedId        String           @map("sender_scoped_id")
  displayName           String?          @map("display_name")
  username              String?
  firstName             String?          @map("first_name")
  lastName              String?          @map("last_name")
  profilePictureUrl     String?          @map("profile_picture_url") @db.Text
  profileFetchedAt      DateTime?        @map("profile_fetched_at")
  profileFetchStatus    String?          @map("profile_fetch_status")
  lastProfileFetchError String?          @map("last_profile_fetch_error") @db.Text
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  metaConnectedAccount MetaConnectedAccount @relation(fields: [metaConnectedAccountId], references: [id], onDelete: Cascade)
  conversations        MetaConversation[]

  @@unique([platform, metaConnectedAccountId, senderScopedId])
  @@index([metaConnectedAccountId])
  @@map("meta_sender_identities")
}

model MetaConversation {
  id                    String   @id @default(uuid())
  metaConnectedAccountId String  @map("meta_connected_account_id")
  senderIdentityId      String   @map("sender_identity_id")
  leadId                String?  @unique @map("lead_id")
  lastMessageAt         DateTime? @map("last_message_at")
  latestMessagePreview  String?  @map("latest_message_preview") @db.VarChar(500)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  metaConnectedAccount MetaConnectedAccount @relation(fields: [metaConnectedAccountId], references: [id], onDelete: Cascade)
  senderIdentity       MetaSenderIdentity   @relation(fields: [senderIdentityId], references: [id], onDelete: Cascade)
  lead                 Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages             MetaMessage[]

  @@unique([metaConnectedAccountId, senderIdentityId])
  @@index([metaConnectedAccountId, lastMessageAt])
  @@index([senderIdentityId])
  @@index([leadId])
  @@map("meta_conversations")
}

model MetaMessage {
  id                    String                   @id @default(uuid())
  conversationId        String                   @map("conversation_id")
  metaConnectedAccountId String                  @map("meta_connected_account_id")
  providerMessageId     String                   @map("provider_message_id")
  platform              MetaPlatformEnum
  direction             MetaMessageDirectionEnum
  messageType           MetaMessageTypeEnum      @map("message_type")
  text                  String?                  @db.Text
  sentAt                DateTime?                @map("sent_at")
  receivedAt            DateTime                 @default(now()) @map("received_at")
  providerMetadata      Json?                    @map("provider_metadata")
  createdAt             DateTime                 @default(now()) @map("created_at")

  conversation         MetaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  metaConnectedAccount MetaConnectedAccount @relation(fields: [metaConnectedAccountId], references: [id], onDelete: Cascade)

  @@unique([platform, metaConnectedAccountId, providerMessageId])
  @@index([conversationId, receivedAt])
  @@map("meta_messages")
}
