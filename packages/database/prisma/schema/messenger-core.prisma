// Additive Messaging Core contracts aligned with the applied Slice 1 schema.
// Channel/DM tables are not replaced.

enum MessengerConversationZone {
  INTERNAL
  CLIENT
}

enum MessengerConversationKind {
  DIRECT
  GROUP
  ENTITY
  EXTERNAL
}

enum MessengerMessageDirection {
  INTERNAL
  INBOUND
  OUTBOUND
}

enum MessengerMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  OUTCOME_UNKNOWN
  CANCELLED
}

enum MessengerMessageProvenance {
  EMPLOYEE
  SYSTEM
  PROVIDER
  AI
}

enum MessengerMessageReferencePurpose {
  FORWARD
  TASK_SOURCE
  TICKET_SOURCE
  DEAL_SOURCE
}

enum MessengerExternalProvider {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum MessengerCommandKind {
  SEND_MESSAGE
  MARK_READ
  ADD_REFERENCE
}

enum MessengerCommandStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MessengerLegacyIdentityKind {
  CHANNEL
  DIRECT_THREAD
  CHANNEL_MESSAGE
  DIRECT_MESSAGE
  TASK
  TASK_DISCUSSION_ENTRY
}

model MessengerExternalConversationMapping {
  id                     String                    @id @default(uuid())
  conversationId         String                    @map("conversation_id")
  provider               MessengerExternalProvider
  externalAccountId      String                    @map("external_account_id")
  externalConversationId String                    @map("external_conversation_id")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  conversation MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, provider])
  @@unique([provider, externalAccountId, externalConversationId])
  @@map("messenger_external_conversation_mappings")
}

/// Durable command/idempotency hook. Slice 1 does not dispatch Gateway.
model MessengerCommand {
  id              String                  @id @default(uuid())
  conversationId  String?                 @map("conversation_id")
  actorEmployeeId String?                 @map("actor_employee_id")
  kind            MessengerCommandKind
  status          MessengerCommandStatus  @default(PENDING)
  idempotencyKey  String                  @unique @map("idempotency_key")
  payload         Json?
  resultMessageId String?                 @map("result_message_id")
  errorCode       String?                 @map("error_code")
  createdAt       DateTime                @default(now()) @map("created_at")
  completedAt     DateTime?               @map("completed_at")

  conversation  MessengerConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  actorEmployee Employee?              @relation("MessengerCommandActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  resultMessage MessengerMessage?      @relation(fields: [resultMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([status])
  @@map("messenger_commands")
}

/// Stable reference to a canonical source message. Deleting a reference never deletes the source.
model MessengerMessageReference {
  id                   String                           @id @default(uuid())
  sourceConversationId String                           @map("source_conversation_id")
  sourceMessageId      String                           @map("source_message_id")
  targetConversationId String?                          @map("target_conversation_id")
  targetMessageId      String?                          @map("target_message_id")
  purpose              MessengerMessageReferencePurpose
  entityType           String?                          @map("entity_type")
  entityId             String?                          @map("entity_id")
  createdById          String?                          @map("created_by_id")
  createdAt            DateTime                         @default(now()) @map("created_at")

  sourceMessage      MessengerMessage        @relation("MessengerMessageReferenceSource", fields: [sourceMessageId], references: [id])
  sourceConversation MessengerConversation   @relation("MessengerMessageReferenceSourceConversation", fields: [sourceConversationId], references: [id])
  targetMessage      MessengerMessage?       @relation("MessengerMessageReferenceTarget", fields: [targetMessageId], references: [id])
  targetConversation MessengerConversation?  @relation("MessengerMessageReferenceTargetConversation", fields: [targetConversationId], references: [id])
  createdBy          Employee?               @relation("MessengerMessageReferenceCreatedBy", fields: [createdById], references: [id])

  @@index([sourceMessageId])
  @@index([purpose, entityType, entityId])
  @@index([targetMessageId])
  @@map("messenger_message_references")
}

model MessengerMessageReaction {
  id         String   @id @default(uuid())
  messageId  String   @map("message_id")
  employeeId String   @map("employee_id")
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at")

  message  MessengerMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  employee Employee         @relation("MessengerMessageReactionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([messageId, employeeId, emoji])
  @@index([employeeId])
  @@map("messenger_message_reactions")
}

model MessengerLegacyIdentity {
  id             String                      @id @default(uuid())
  sourceKind     MessengerLegacyIdentityKind @map("source_kind")
  sourceId       String                      @map("source_id")
  conversationId String?                     @map("conversation_id")
  messageId      String?                     @map("message_id")
  createdAt      DateTime                    @default(now()) @map("created_at")

  conversation MessengerConversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@unique([sourceKind, sourceId])
  @@index([conversationId])
  @@index([messageId])
  @@map("messenger_legacy_identities")
}

enum MessengerCollectionVisibility {
  PERSONAL
  SHARED
}

/// Zone-scoped grouping. Membership never grants conversation ACL (M-BOUNDARY-02, M-COLLECTIONS-01).
model MessengerConversationCollection {
  id              String                         @id @default(uuid())
  name            String
  visibility      MessengerCollectionVisibility
  zone            MessengerConversationZone
  ownerEmployeeId String                         @map("owner_employee_id")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  owner   Employee                                @relation("MessengerConversationCollectionOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  items   MessengerConversationCollectionItem[]
  members MessengerConversationCollectionMember[]

  @@index([ownerEmployeeId, zone])
  @@index([zone, visibility])
  @@map("messenger_conversation_collections")
}

model MessengerConversationCollectionItem {
  id             String   @id @default(uuid())
  collectionId   String   @map("collection_id")
  conversationId String   @map("conversation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  collection   MessengerConversationCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  conversation MessengerConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([collectionId, conversationId], map: "messenger_collection_items_pair_key")
  @@index([conversationId])
  @@map("messenger_conversation_collection_items")
}

model MessengerConversationCollectionMember {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  employeeId   String   @map("employee_id")
  createdAt    DateTime @default(now()) @map("created_at")

  collection MessengerConversationCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  employee   Employee                        @relation("MessengerConversationCollectionMemberEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([collectionId, employeeId], map: "messenger_collection_members_pair_key")
  @@index([employeeId])
  @@map("messenger_conversation_collection_members")
}
