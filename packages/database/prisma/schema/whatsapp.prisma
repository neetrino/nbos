// ─── WHATSAPP GATEWAY / PRODUCT GROUPS ─────────────────────

enum WhatsAppGatewayConnectionStatusEnum {
  NOT_CONFIGURED
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ProductWhatsAppGroupBindingStatusEnum {
  PENDING
  CREATING
  ACTIVE
  FAILED
  OUTCOME_UNKNOWN
  NEEDS_RECONCILIATION
}

enum WhatsAppGroupOperationTypeEnum {
  CREATE_PRODUCT_GROUP
  BIND_EXISTING_GROUP
  SYNC_PRODUCT_PARTICIPANTS
  ADD_PRODUCT_PARTICIPANT
  SEND_CLIENT_INVITE
}

enum WhatsAppGroupOperationStatusEnum {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  OUTCOME_UNKNOWN
  SKIPPED
}

enum WhatsAppGroupOperationSourceEnum {
  PRODUCT_CREATED
  DEAL_ACTION
  DEAL_WON
  EARLY_DELIVERY
  RECONCILIATION
  MANUAL_RETRY
  DEVELOPMENT_TS
  MANUAL_BIND
  MANUAL_SYNC
  MANUAL_INVITE
}

enum ProductWhatsAppParticipantSyncStatusEnum {
  PENDING
  ADDED
  ALREADY_MEMBER
  SKIPPED_NO_PHONE
  SKIPPED_INVALID_PHONE
  FAILED
}

enum ProductWhatsAppClientInvitationStatusEnum {
  PENDING
  QUEUED
  SENT
  FAILED
  SKIPPED_NO_CONTACT
  SKIPPED_NO_PHONE
  OUTCOME_UNKNOWN
}

/// Singleton WhatsApp Gateway connection (single-company NBOS).
model WhatsAppGatewayConnection {
  id                 String                             @id @default(uuid())
  baseUrl            String?                            @map("base_url")
  encryptedApiToken  String?                            @map("encrypted_api_token") @db.Text
  status             WhatsAppGatewayConnectionStatusEnum @default(NOT_CONFIGURED)
  lastHealthCheckAt  DateTime?                          @map("last_health_check_at")
  lastConnectedAt    DateTime?                          @map("last_connected_at")
  lastErrorCode           String?                            @map("last_error_code")
  lastErrorMessage        String?                            @map("last_error_message") @db.Text
  accountingGroupChatId  String?                            @map("accounting_group_chat_id")
  createdAt              DateTime                           @default(now()) @map("created_at")
  updatedAt          DateTime                           @updatedAt @map("updated_at")

  @@map("whatsapp_gateway_connections")
}

/// Product owns at most one WhatsApp group binding.
model ProductWhatsAppGroupBinding {
  id                   String                                 @id @default(uuid())
  productId            String                                 @unique @map("product_id")
  groupChatId          String?                                @unique @map("group_chat_id")
  groupName            String?                                @map("group_name")
  status               ProductWhatsAppGroupBindingStatusEnum  @default(PENDING)
  createdFromDealId    String?                                @map("created_from_deal_id")
  lastSuccessfulSyncAt DateTime?                              @map("last_successful_sync_at")
  lastErrorCode        String?                                @map("last_error_code")
  lastErrorMessage     String?                                @map("last_error_message") @db.Text
  createdAt            DateTime                               @default(now()) @map("created_at")
  updatedAt            DateTime                               @updatedAt @map("updated_at")

  product         Product                          @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdFromDeal Deal?                            @relation("ProductWhatsAppGroupCreatedFromDeal", fields: [createdFromDealId], references: [id], onDelete: SetNull)
  operations      WhatsAppGroupOperation[]
  participants    ProductWhatsAppParticipantSync[]
  invitations     ProductWhatsAppClientInvitation[]

  @@index([status])
  @@index([createdFromDealId])
  @@map("product_whatsapp_group_bindings")
}

model WhatsAppGroupOperation {
  id                String                            @id @default(uuid())
  productId         String                            @map("product_id")
  bindingId         String?                           @map("binding_id")
  type              WhatsAppGroupOperationTypeEnum
  status            WhatsAppGroupOperationStatusEnum  @default(PENDING)
  dedupeKey         String                            @unique @map("dedupe_key")
  source            WhatsAppGroupOperationSourceEnum
  contextDealId     String?                           @map("context_deal_id")
  requestedById     String?                           @map("requested_by_id")
  attemptCount      Int                               @default(0) @map("attempt_count")
  gatewayRequestId  String?                           @map("gateway_request_id")
  safePayload       Json?                             @map("safe_payload")
  resultMetadata    Json?                             @map("result_metadata")
  errorCode         String?                           @map("error_code")
  errorMessage      String?                           @map("error_message") @db.Text
  queuedAt          DateTime?                         @map("queued_at")
  startedAt         DateTime?                         @map("started_at")
  completedAt       DateTime?                         @map("completed_at")
  failedAt          DateTime?                         @map("failed_at")
  createdAt         DateTime                          @default(now()) @map("created_at")
  updatedAt         DateTime                          @updatedAt @map("updated_at")

  product     Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  binding     ProductWhatsAppGroupBinding?   @relation(fields: [bindingId], references: [id], onDelete: SetNull)
  contextDeal Deal?                          @relation("WhatsAppGroupOperationContextDeal", fields: [contextDealId], references: [id], onDelete: SetNull)
  requestedBy Employee?                      @relation("WhatsAppGroupOperationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([productId, type, status])
  @@index([status, queuedAt])
  @@index([bindingId])
  @@map("whatsapp_group_operations")
}

model ProductWhatsAppParticipantSync {
  id               String                                    @id @default(uuid())
  productId        String                                    @map("product_id")
  bindingId        String                                    @map("binding_id")
  employeeId       String                                    @map("employee_id")
  sourceRoles      Json                                      @map("source_roles")
  status           ProductWhatsAppParticipantSyncStatusEnum  @default(PENDING)
  lastAttemptAt    DateTime?                                 @map("last_attempt_at")
  addedAt          DateTime?                                 @map("added_at")
  lastErrorCode    String?                                   @map("last_error_code")
  lastErrorMessage String?                                   @map("last_error_message") @db.Text
  createdAt        DateTime                                  @default(now()) @map("created_at")
  updatedAt        DateTime                                  @updatedAt @map("updated_at")

  product  Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  binding  ProductWhatsAppGroupBinding  @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  employee Employee                     @relation("ProductWhatsAppParticipantSyncEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([bindingId, employeeId])
  @@index([productId])
  @@index([employeeId])
  @@index([status])
  @@map("product_whatsapp_participant_syncs")
}

model ProductWhatsAppClientInvitation {
  id               String                                    @id @default(uuid())
  productId        String                                    @map("product_id")
  bindingId        String                                    @map("binding_id")
  contactId        String?                                   @map("contact_id")
  status           ProductWhatsAppClientInvitationStatusEnum @default(PENDING)
  dedupeKey        String                                    @unique @map("dedupe_key")
  attemptCount     Int                                       @default(0) @map("attempt_count")
  sentAt           DateTime?                                 @map("sent_at")
  lastAttemptAt    DateTime?                                 @map("last_attempt_at")
  lastErrorCode    String?                                   @map("last_error_code")
  lastErrorMessage String?                                   @map("last_error_message") @db.Text
  createdAt        DateTime                                  @default(now()) @map("created_at")
  updatedAt        DateTime                                  @updatedAt @map("updated_at")

  product Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  binding ProductWhatsAppGroupBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  contact Contact?                    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([bindingId])
  @@index([contactId])
  @@index([status])
  @@map("product_whatsapp_client_invitations")
}
