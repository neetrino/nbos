// ─── SYSTEM LISTS (reference data: product types, deal types, etc.) ───

model SystemListOption {
  id        String   @id @default(uuid())
  listKey   String   @map("list_key")
  code      String
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([listKey, code])
  @@index([listKey])
  @@map("system_list_options")
}

/// Server-side allocator for per-year human-readable entity codes such as `T-2026-0007`.
///
/// Reading the highest existing code and then inserting races: two concurrent
/// creates compute the same number and the second violates the unique code
/// column. One atomic upsert per allocation removes that window. `scope`
/// (`TASK`, `INVOICE`, `SUPPORT_TICKET`, `DEAL`, `LEAD`, `ORDER`,
/// `SUBSCRIPTION`, `PROJECT`) keeps one table serving every numbered entity,
/// and `year` gives each one an independent series that restarts in January.
model EntityCodeCounter {
  scope     String
  year      Int
  /// Last number handed out for this scope and year. The next allocation returns this + 1.
  nextValue Int      @map("next_value")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@id([scope, year])
  @@map("entity_code_counters")
}
