{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": false,
    "assets": ["**/*.ttf", "**/*.LICENSE"]
  },
  "watchOptions": {
    "ignored": ["node_modules", "dist"]
  }
}
