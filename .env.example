# NBOS — canonical environment template
# Copy to .env.local for local development. In Coolify, copy only the keys needed by each service.
# Never commit real values. A commented KEY is optional or an advanced rollout switch.

# ─────────────────────────────────────────────
# A. Shared application values
# ─────────────────────────────────────────────
NODE_ENV="development"

# Public web origin. In production all three values normally equal https://app.<domain>.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Server-side Web → API and browser realtime → API.
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

# Browser origins allowed by API, comma-separated.
CORS_ORIGIN="http://localhost:3000"

# Neon pooled URL for runtime; direct URL is used only by Prisma migrations.
DATABASE_URL="postgresql://app_user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neon_owner:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Production startup requires the real Neon plan limit.
DB_TOTAL_CONNECTION_BUDGET=100

# Web session secret, API JWT secret, and encrypted integration/credential secret.
# Generate each independently: openssl rand -base64 32
AUTH_SECRET="generate-a-separate-secret-at-least-32-characters"
JWT_SECRET="generate-a-separate-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
CREDENTIALS_ENCRYPTION_KEY="generate-a-separate-secret-at-least-32-characters"

# Required in production even when external cron is not used.
SCHEDULER_API_KEY="generate-a-separate-secret-at-least-32-characters"

# Local API port. Coolify overrides ports per service.
PORT=4000

# ─────────────────────────────────────────────
# B. Redis — required for the full project
# ─────────────────────────────────────────────
# BullMQ workers, queues, JWT denylist, vault state, and multi-replica realtime use Redis.
# NBOS uses the Redis protocol through ioredis/BullMQ. UPSTASH_REDIS_REST_* is not read.
# Local example: redis://localhost:6379
# Production must use a TLS connection string such as rediss://default:<password>@<host>:6379
REDIS_URL=""

# Optional separation. When empty/unset, all three fall back to REDIS_URL.
# REDIS_QUEUE_URL=""
# REDIS_STATE_URL=""
# REDIS_EVENTS_URL=""

# ─────────────────────────────────────────────
# C. Optional integrations (empty = that feature is unavailable)
# ─────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_ADMIN_EMAIL=""

# Drive / R2. All six values are needed for complete Drive uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nbos"
R2_PUBLIC_URL=""
NBOS_TENANT_ORGANIZATION_ID="00000000-0000-4000-8000-000000000001"

# Gmail OAuth only. Corporate IMAP/SMTP mailboxes do not need these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# MAIL_GMAIL_PUBSUB_TOPIC=""
# MAIL_GMAIL_PUBSUB_TOKEN=""

# Prefer configuring WhatsApp URL/token in Settings → Integrations (encrypted in DB).
# WHATSAPP_GATEWAY_URL="https://wa-gateway.example.com"

# Meta / Instagram integration.
# META_APP_ID=""
# META_APP_SECRET=""
# INSTAGRAM_APP_ID=""
# INSTAGRAM_APP_SECRET=""
# META_WEBHOOK_VERIFY_TOKEN=""
# META_GRAPH_API_VERSION="v21.0"

# ATS.am inbound phone webhook. Unset means the webhook returns 503.
# ATS_API_KEY=""

# One-time admin seed only; these are not normal application runtime variables.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─────────────────────────────────────────────
# D. Coolify process split
# ─────────────────────────────────────────────
# Do not set PROCESS_ROLE locally: local default is all.
# Create three services from the API image and set exactly one role per service:
#   nbos-api       PROCESS_ROLE=api       PORT=4000
#   nbos-worker    PROCESS_ROLE=worker    WORKER_HEALTH_PORT=4001
#   nbos-scheduler PROCESS_ROLE=scheduler SCHEDULER_HEALTH_PORT=4002
# Production forbids PROCESS_ROLE=all.
# PROCESS_ROLE="api"

# Worker tuning. Defaults are already safe for the first single-replica rollout.
# WORKER_HEALTH_PORT=4001
# WORKER_SHUTDOWN_TIMEOUT_MS=45000
# BULLMQ_MAIL_CONCURRENCY=5
# BULLMQ_WHATSAPP_CONCURRENCY=3
# BULLMQ_REPORTS_CONCURRENCY=1
# BULLMQ_DRIVE_ZIP_CONCURRENCY=1
# Idle-queue poll. Default 20s (BullMQ library default is 5s — too chatty on Upstash).
# BULLMQ_DRAIN_DELAY_SEC=20
# BULLMQ_STALLED_INTERVAL_MS=120000

# Never run queue work synchronously inside the production API.
REPORT_EXPORT_SYNC_FALLBACK="false"
DRIVE_ZIP_EXPORT_SYNC_FALLBACK="false"

# ─────────────────────────────────────────────
# E. Dedicated scheduler
# ─────────────────────────────────────────────
# Safe first deploy: scheduler process is healthy but executes no business cron.
# Enable the scheduler and one job at a time after checking its domain behavior.
SCHEDULER_ENABLED="false"
# TZ="Asia/Yerevan"
# SCHEDULER_HEALTH_PORT=4002
# SCHEDULER_LEASE_TTL_MS=120000
# SCHEDULER_HEARTBEAT_INTERVAL_MS=30000
# SCHEDULER_SHUTDOWN_TIMEOUT_MS=45000
# SCHEDULER_MAX_CONCURRENT_RUNS=2

# Recurring Task templates → Task instances.
# SCHEDULER_RECURRING_TASKS_DUE_ENABLED="false"
# SCHEDULER_RECURRING_TASKS_DUE_CRON="*/10 * * * *"

# Expense plans → due Expense cards.
# SCHEDULER_EXPENSE_PLAN_AUTO_DUE_ENABLED="false"
# SCHEDULER_EXPENSE_PLAN_AUTO_DUE_CRON="0 2 * * *"
# SCHEDULER_CLIENT_SERVICES_RENEWAL_INVOICE_ENABLED="false"
# SCHEDULER_CLIENT_SERVICES_RENEWAL_INVOICE_CRON="0 6 * * *"

# Explicitly disabled until scheduled reports are intentionally launched.
REPORT_SCHEDULES_DUE_CRON_ENABLED="false"
# REPORT_SCHEDULES_DUE_CRON="*/5 * * * *"

# Unified trash retention (credentials + Drive + mail + Profile A).
# SCHEDULER_PLATFORM_TRASH_PURGE_ENABLED="false"
# SCHEDULER_PLATFORM_TRASH_PURGE_CRON="30 3 * * 0"

# Notification rollout jobs; leave off until the matching feature rollout is approved.
# SCHEDULER_NOTIFICATION_INBOX_RECONCILE_ENABLED="false"
# SCHEDULER_NOTIFICATION_INBOX_RECONCILE_CRON="*/15 * * * *"
# SCHEDULER_NOTIFICATION_ENQUEUE_RECONCILE_ENABLED="false"
# SCHEDULER_NOTIFICATION_ENQUEUE_RECONCILE_CRON="*/10 * * * *"

# Mail outbound orphan reconcile (Slice A). Leave off until send queue is live on prod.
# SCHEDULER_MAIL_OUTBOUND_RECONCILE_ENABLED="false"
# SCHEDULER_MAIL_OUTBOUND_RECONCILE_CRON="*/2 * * * *"

# Mail Gmail watch renew (Slice B). Leave off until watch topic is live on prod.
# SCHEDULER_MAIL_GMAIL_WATCH_RENEW_ENABLED="false"
# SCHEDULER_MAIL_GMAIL_WATCH_RENEW_CRON="0 * * * *"

# Mail inbox poll / sync reconcile (Slice B). Leave off until receive queue is live on prod.
# SCHEDULER_MAIL_SYNC_RECONCILE_ENABLED="false"
# SCHEDULER_MAIL_SYNC_RECONCILE_CRON="*/5 * * * *"

# Auth Session V2 cleanup; leave off while legacy auth is active.
# SCHEDULER_AUTH_SESSION_CLEANUP_ENABLED="false"
# SCHEDULER_AUTH_SESSION_CLEANUP_CRON="15 * * * *"
# AUTH_SESSION_CLEANUP_BATCH_SIZE=500

# Former HTTP-only jobs. Enable one at a time on nbos-scheduler after SCHEDULER_ENABLED=true.
# TZ="Asia/Yerevan"
# SCHEDULER_BILLING_ENABLED="false"
# SCHEDULER_BILLING_CRON="0 3 1 * *"
# SCHEDULER_OVERDUE_INVOICES_ENABLED="false"
# SCHEDULER_OVERDUE_INVOICES_CRON="0 5 * * *"
# SCHEDULER_INVOICE_CARD_REMINDERS_ENABLED="false"
# SCHEDULER_INVOICE_CARD_REMINDERS_CRON="0 11 * * *"
# SCHEDULER_EXPENSE_BACKLOG_REMINDERS_ENABLED="false"
# SCHEDULER_EXPENSE_BACKLOG_REMINDERS_CRON="0 7 * * *"
# SCHEDULER_SALES_KPI_MONTH_CLOSE_ENABLED="false"
# SCHEDULER_SALES_KPI_MONTH_CLOSE_CRON="0 8 1 * *"
# SCHEDULER_SUPPORT_SLA_ESCALATION_ENABLED="false"
# SCHEDULER_SUPPORT_SLA_ESCALATION_CRON="*/15 * * * *"
# ─────────────────────────────────────────────
# F. Advanced rollout and database tuning
# ─────────────────────────────────────────────
# Not required for the first deployment. Defaults are defined in code.
# Add only the flag being rolled out; see docs/architecture and docs/deploy.md.

# Ops-only secret warning:
# COOLIFY_TOKEN is not an NBOS runtime variable. Never add a full-access Coolify token
# to web/api/worker/scheduler environments. Keep it only in a separate local ops secret store.
