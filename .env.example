# NBOS Platform — Environment Variables
# Copy to .env.local and fill with real values

# ——— Runtime ———
NODE_ENV="development"

# ——— Web (public UI origin) ———
# Один и тот же origin в адресной строке. APP_URL — ссылки в письмах/колбэках (API).
# AUTH_URL — Auth.js (сессия /api/auth/*). NEXTAUTH_URL — alias для совместимости; можно = AUTH_URL.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ——— Web → API ———
# Nest origin для BFF и server-side login. Локально: http://localhost:4000
BACKEND_URL="http://localhost:4000"

# ——— API: browser origins (CORS, Socket.IO, Next dev LAN) ———
# Через запятую: каждый origin, с которого открываешь UI (localhost, LAN IP, staging).
# Не путать с BACKEND_URL — это allowlist для браузера, не адрес API.
CORS_ORIGIN="http://localhost:3000"

# ——— Database (Neon PostgreSQL) ———
DATABASE_URL="postgresql://app_user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neon_owner:password@ep-xxx.neon.tech/neondb?sslmode=require"
# Connection budget (production requires DB_TOTAL_CONNECTION_BUDGET)
# DB_TOTAL_CONNECTION_BUDGET=100
# DB_RESERVED_CONNECTIONS=4
# API_REPLICA_COUNT=1
# WORKER_REPLICA_COUNT=1
# SCHEDULER_REPLICA_COUNT=1
# DB_POOL_MAX_API=5
# DB_POOL_MAX_WORKER=4
# DB_POOL_MAX_SCHEDULER=2
# DB_POOL_TIMEOUT_SEC=10
# DB_CONNECT_TIMEOUT_SEC=10
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_READINESS_CACHE_MS=5000
# DB_READINESS_TIMEOUT_MS=2000
# DB_QUERY_METRICS_ENABLED="false"
# DB_SLOW_QUERY_THRESHOLD_MS=500
# DB_QUERY_SAMPLE_RATE=0.01
# SCHEDULER_MAX_CONCURRENT_RUNS=2

# ——— Auth (NextAuth + собственный JWT) ———
# NextAuth: секрет для шифрования сессий (обязателен, min 32 символа)
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Backend JWT: секрет для подписи access-токенов
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ——— Cache (Upstash Redis) ———
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN=""

# ——— Email (Resend) ———
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="nbos@neetrino.com"
RESEND_ADMIN_EMAIL=""
# Первый админ для bootstrap-сида: pnpm --filter @nbos/database run seed:admin
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ——— File storage (Cloudflare R2) ———
# New uploads use nbos/tenants/{NBOS_TENANT_ORGANIZATION_ID}/files/... (storage home).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nbos"
R2_PUBLIC_URL=""
# Required for Drive uploads: stable tenant UUID in R2 paths (nbos/tenants/{id}/files/...).
NBOS_TENANT_ORGANIZATION_ID="00000000-0000-4000-8000-000000000001"

# ——— API (Backend — NestJS, Coolify service nbos-api) ———
PORT=4000
# Service key for /api/scheduler/* (external cron). Required in production.
# Senders must pass it as `x-scheduler-key: <key>` or `Authorization: Bearer <key>`.
# Generate: openssl rand -base64 32
SCHEDULER_API_KEY=""
# BullMQ: report export jobs (`ReportExportJob`). Set in production with a worker consuming the same queue.
# Also used by WhatsApp Product group jobs (`whatsapp.product-groups`).
# REDIS_URL="redis://..."
# Optional dedicated Redis URLs (fallback to REDIS_URL when unset). Prefer not changing QUEUE URL without a drain plan.
# REDIS_QUEUE_URL="redis://..."
# REDIS_STATE_URL="redis://..."
# Realtime Pub/Sub for notification SSE fan-out across API replicas (falls back to REDIS_URL).
# Prefer a dedicated Redis DB/instance in production when available.
# REDIS_EVENTS_URL="redis://..."
# Process role: local default is `all` (API+workers). Production MUST set api|worker|scheduler (not all).
# PROCESS_ROLE="all"
# Worker health HTTP port (Coolify). Defaults to PORT or 4001.
# WORKER_HEALTH_PORT=4001
# WORKER_SHUTDOWN_TIMEOUT_MS=45000
# BullMQ concurrency (validated 1–32). Total = replicas × value.
# BULLMQ_MAIL_CONCURRENCY=5
# BULLMQ_WHATSAPP_CONCURRENCY=3
# BULLMQ_REPORTS_CONCURRENCY=1
# BULLMQ_DRIVE_ZIP_CONCURRENCY=1
# NotificationInboxState rollout (defaults: all off → unread still uses COUNT(*))
# NOTIFICATION_INBOX_STATE_WRITE_ENABLED="false"
# NOTIFICATION_INBOX_STATE_READ_ENABLED="false"
# NOTIFICATION_INBOX_STATE_RECONCILE_ENABLED="false"
# Phase 5 notification write-path flags (defaults off → legacy create path)
# NOTIFICATION_COMMAND_V2_ENABLED="false"
# NOTIFICATION_BULK_WRITE_ENABLED="false"
# NOTIFICATION_SSE_FROM_INBOX_STATE_ENABLED="false"
# NOTIFICATION_ENQUEUE_RECONCILE_ENABLED="false"
# NOTIFICATION_BATCH_SIZE=200
# NOTIFICATION_BATCH_CONCURRENCY=4
# NOTIFICATION_METRICS_LOG="false"
# ——— Dedicated nbos-scheduler (PROCESS_ROLE=scheduler) ———
# SCHEDULER_ENABLED="false"
# SCHEDULER_LEASE_TTL_MS=120000
# SCHEDULER_HEARTBEAT_INTERVAL_MS=30000
# SCHEDULER_HEALTH_PORT=4002
# SCHEDULER_SHUTDOWN_TIMEOUT_MS=45000
# Per-job cron flags (also require SCHEDULER_ENABLED on dedicated scheduler):
# SCHEDULER_NOTIFICATION_INBOX_RECONCILE_ENABLED="false"
# SCHEDULER_NOTIFICATION_INBOX_RECONCILE_CRON="*/15 * * * *"
# SCHEDULER_NOTIFICATION_ENQUEUE_RECONCILE_ENABLED="false"
# SCHEDULER_NOTIFICATION_ENQUEUE_RECONCILE_CRON="*/10 * * * *"
# SCHEDULER_EXPENSE_PLAN_AUTO_DUE_ENABLED="false"
# REPORT_SCHEDULES_DUE_CRON_ENABLED="false"
# SCHEDULER_CREDENTIAL_TRASH_PURGE_ENABLED="false"
# SCHEDULER_PLATFORM_TRASH_PURGE_ENABLED="false"
# Local-only: run export processing inside the API process when Redis is unset. Never enable in production.
# REPORT_EXPORT_SYNC_FALLBACK="false"

# ——— WhatsApp Gateway (optional bootstrap URL; DB encrypted token is preferred) ———
# Public HTTPS Gateway base URL only. Never set WAHA_API_KEY / WAHA_BASE_URL in NBOS.
# Prefer configuring URL + token in Settings → Integrations (encrypted in DB).
# WHATSAPP_GATEWAY_URL="https://wa-gateway.example.com"

# ——— Credentials Encryption ———
CREDENTIALS_ENCRYPTION_KEY=""

# ——— Mail module (Gmail + corporate IMAP/SMTP) ———
# Gmail OAuth redirect URI is built from BACKEND_URL:
# <BACKEND_URL>/api/mail/oauth/google/callback
# Gmail OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client, type Web).
# Required only for Gmail mailboxes; corporate IMAP/SMTP works without these.
# Authorized redirect URI must be: <BACKEND_URL>/api/mail/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Gmail Pub/Sub topic for near-real-time receive (Google Cloud Pub/Sub). Format: projects/<project>/topics/<topic>.
# When unset, Gmail still syncs on connect + manual "Sync now"; Pub/Sub push is skipped.
# MAIL_GMAIL_PUBSUB_TOPIC=""
# Shared secret appended to the Pub/Sub push endpoint (?token=...) to authenticate Google push requests.
# MAIL_GMAIL_PUBSUB_TOKEN=""

# ——— Meta integration (Instagram / Facebook DM → CRM Lead) ———
# OAuth redirect (both flows): <BACKEND_URL>/api/integrations/meta/oauth/callback
# Webhook URL: <BACKEND_URL>/api/integrations/meta/webhook
# Optional in local dev; required when Meta connect/webhook is enabled.
# META_APP_ID=""          # Facebook Messenger OAuth
# META_APP_SECRET=""
# INSTAGRAM_APP_ID=""     # Instagram Login OAuth (dedicated Instagram app)
# INSTAGRAM_APP_SECRET=""
# META_WEBHOOK_VERIFY_TOKEN=""
# META_GRAPH_API_VERSION="v21.0"

# ——— ATS.am Active Call (inbound phone → CRM Lead) ———
# Webhook URL: <BACKEND_URL>/api/integrations/ats/webhook?key=<ATS_API_KEY>
# Shared secret from ATS personal cabinet («Գրանցված տվյալներ»). Optional in local
# dev; when unset, webhook returns 503. Do not commit real keys.
# ATS_API_KEY=""

# ——— Optional ———
# Log level for nestjs-pino (trace|debug|info|warn|error). Default: info (prod) / debug (dev).
# LOG_LEVEL="info"
# SENTRY_DSN=""
# POSTHOG_API_KEY=""

# ——— API in-process scheduler (Nest) ———
# Expense plan auto-generate (due): same as POST /api/scheduler/expense-plan-auto-due.
# Default off. Set ENABLED=true to register a cron in the API process; prefer external cron in production.
# Ops recipe (curl, crontab, TZ): docs/reference/platforms/expense-plan-auto-due-external-cron.md
# External callers: NBOS_API_BASE = origin only (e.g. https://api.example.com), no trailing /api — paths already include /api/...
# SCHEDULER_EXPENSE_PLAN_AUTO_DUE_ENABLED="false"
# Five-field cron; default 02:00 daily in process TZ if unset (set TZ=UTC for UTC wall clock).
# SCHEDULER_EXPENSE_PLAN_AUTO_DUE_CRON="0 2 * * *"
